{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["timestamp", "expected_energy_kwh", "expected_sessions", "model_version"],
  "additionalProperties": false,
  "properties": {
    "timestamp": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00$"},
    "expected_energy_kwh": {"type": "number", "minimum": 0},
    "expected_sessions": {"type": "number", "minimum": 0},
    "model_version": {"type": "string", "minLength": 1}
  }
}
