# Local datasets; retain repository placeholders only
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md

# Root model and artifact stores; retain policy files only
models/*
!models/README.md
artifacts/*
!artifacts/README.md

# Team-local generated artifacts; retain placeholders only
team/*/artifacts/*
!team/*/artifacts/.gitkeep

# Trained model and serialized binary formats
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.hdf5
*.joblib
*.pkl
*.pickle

# Large data formats should be referenced, not committed
*.parquet
*.feather
*.arrow
